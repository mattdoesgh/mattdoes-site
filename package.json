{
  "name": "mattdoes-site",
  "version": "0.1.0",
  "private": true,
  "description": "mattdoes.online — in-repo notes → static HTML",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p site/tsconfig.json --noEmit",
    "build": "NODE_ENV=production node build.js",
    "build:offline": "NODE_ENV=production LETTERBOXD_OFFLINE=1 SITE_URL=https://mattdoes.online node build.js",
    "clean": "rm -rf dist",
    "lint": "html-validate \"dist/**/*.html\"",
    "audit": "npm audit --audit-level=moderate",
    "check:assets": "node scripts/check-asset-budget.js",
    "check:tokens": "node scripts/check-design-tokens.js",
    "test:visual": "playwright test -c playwright.config.js",
    "scan:secrets": "npx --yes gitleaks detect --source . --verbose",
    "test": "npm run build:offline && npm run test:all",
    "test:fast": "node --test test/asset-headers.test.js test/contrast.test.js test/emit-units.test.js test/flock-model.test.js test/letterboxd.test.js test/media.test.js test/posters.test.js test/publish-unshared.test.js test/suno-songs.test.js test/url-safety.test.js test/workflow-permissions.test.js \"test/worker-*.test.js\"",
    "test:all": "node --test \"test/**/*.test.js\"",
    "deploy:workers": "node scripts/deploy-workers.js",
    "suno:sync": "node scripts/suno-sync.js"
  },
  "dependencies": {
    "sharp": "^0.35.3"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "axe-core": "^4.14.0",
    "culori": "^4.0.2",
    "html-validate": "^11.17.0",
    "jsdom": "^31.0.1",
    "lightningcss": "^1.33.0",
    "playwright": "^1.64.1",
    "terser": "^5.51.2",
    "typescript": "^7.0.2"
  }
}
