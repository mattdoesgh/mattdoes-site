{
  "name": "mattdoes-site",
  "version": "0.1.0",
  "private": true,
  "description": "mattdoes.online — in-repo notes → static HTML",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p site/tsconfig.json --noEmit",
    "build": "NODE_ENV=production node build.js",
    "clean": "rm -rf dist",
    "lint": "html-validate \"dist/**/*.html\"",
    "audit": "npm audit --audit-level=moderate",
    "check:assets": "node scripts/check-asset-budget.js",
    "check:tokens": "node scripts/check-design-tokens.js",
    "test:visual": "playwright test -c playwright.config.js",
    "scan:secrets": "npx --yes gitleaks detect --source . --verbose",
    "pretest": "NODE_ENV=production LETTERBOXD_OFFLINE=1 SITE_URL=https://mattdoes.online node build.js",
    "test": "node --test \"test/**/*.test.js\"",
    "deploy:workers": "node scripts/deploy-workers.js",
    "suno:sync": "node scripts/suno-sync.js"
  },
  "dependencies": {
    "sharp": "^0.35.3"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "axe-core": "^4.14.1",
    "culori": "^4.0.2",
    "html-validate": "^11.21.1",
    "jsdom": "^30.1.3",
    "lightningcss": "^1.33.0",
    "playwright": "^1.65.1",
    "terser": "^5.51.4",
    "typescript": "^7.0.2"
  }
}
