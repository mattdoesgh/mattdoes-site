{
  "name": "mattdoes-site",
  "version": "0.1.0",
  "private": true,
  "description": "mattdoes.online — in-repo notes → static HTML",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p site/tsconfig.json --noEmit",
    "build": "NODE_ENV=production node build.js",
    "clean": "rm -rf dist",
    "lint": "html-validate \"dist/**/*.html\"",
    "audit": "npm audit --audit-level=moderate",
    "check:assets": "node scripts/check-asset-budget.js",
    "check:tokens": "node scripts/check-design-tokens.js",
    "test:visual": "playwright test -c playwright.config.js",
    "scan:secrets": "npx --yes gitleaks detect --source . --verbose",
    "pretest": "NODE_ENV=production LISTENING_OFFLINE=1 LETTERBOXD_OFFLINE=1 SITE_URL=https://mattdoes.online node build.js",
    "test": "node --test \"test/**/*.test.js\"",
    "deploy:workers": "node scripts/deploy-workers.js",
    "optimize-media": "node scripts/optimize-media.js",
    "sync-media": "node --env-file-if-exists=.env scripts/sync-media.js"
  },
  "dependencies": {
    "sharp": "^0.35.3"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "axe-core": "^4.14.0",
    "culori": "^4.0.2",
    "html-validate": "^11.16.2",
    "jsdom": "^30.1.3",
    "lightningcss": "^1.33.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "terser": "^5.51.2",
    "typescript": "^5.9.3"
  }
}
