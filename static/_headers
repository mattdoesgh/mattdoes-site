# Cloudflare Pages — response headers
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  # Permissions-Policy: geolocation is allowed for self only — the opt-in
  # city map in the tweaks panel reverse-geocodes the visitor's coords.
  # Every other powerful feature the site does not use is explicitly denied,
  # plus the interest-cohort / browsing-topics opt-outs.
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=(), midi=(), magnetometer=(), accelerometer=(), gyroscope=(), display-capture=(), screen-wake-lock=(), xr-spatial-tracking=(), serial=(), bluetooth=(), hid=(), interest-cohort=(), browsing-topics=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  # CSP keeps style-src strict: pages ship one stylesheet and no inline styles.
  # Report-only twin collects any regressions before enforcement changes.
  # The station shell has no inline scripts, so the build does not append
  # sha256 sources. A hash source would disable 'inline-speculation-rules',
  # which stays as a keyword. If an inline script is added, hash every one
  # of them together (lib/emit/csp.js).
  # frame-src admits a player the page actually embeds. Bandcamp is
  # omitted while unsharedPlayer.bandcamp in site/verbs.ts is unset.
  # Add https://bandcamp.com here only together with that URL.
  #
  # Declare each CSP header on this one rule only. Pages joins a header that
  # appears on two matching rules with a comma, and browsers then enforce both
  # policies. A path-specific rule (/, /*/, /*.html) must not repeat it.
  #
  # script-src 'self' admits the same-origin Email Obfuscation decoder
  # (/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js). That
  # path is Cloudflare's, not a Pages function or a Worker route.
  # https://static.cloudflareinsights.com is the Pages Web Analytics beacon.
  # connect-src allows that beacon to report to https://cloudflareinsights.com.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com 'inline-speculation-rules'; img-src 'self' https://media.mattdoes.online data:; media-src 'self' https://media.mattdoes.online; style-src 'self'; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; frame-ancestors 'self'; frame-src https://embed.music.apple.com; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests
  # Report-only twin of the enforced CSP — collects browser violations at the
  # same-origin /api/csp-report Worker before tightening style-src.
  # Keep its sources identical to the enforced policy (plus report-uri) so the
  # beacon is not reported as a violation after it is allowed.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com 'inline-speculation-rules'; img-src 'self' https://media.mattdoes.online data:; media-src 'self' https://media.mattdoes.online; style-src 'self'; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; frame-ancestors 'self'; frame-src https://embed.music.apple.com; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests; report-uri https://mattdoes.online/api/csp-report

# ── Fonts ───────────────────────────────────────────────────────────────
# Stable filenames, cached for a year. Hashed CSS and JS are not listed
# here: Emit writes one exact rule per real file (ADR 0013). Do not add
# `/*.css` or `/*.js` — Pages would attach this cache policy to the HTML
# document it used to serve for a missing hash.

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# ── Same-origin SVG fallback ────────────────────────────────────────────
# dist/img still ships (local /img when the media CDN is not in use).
# An SVG navigated to as a document can run script. Serve these as
# downloads so that navigation does not render them. <img> embeds are
# a different context and keep working.
/img/*.svg
  Content-Disposition: attachment
  X-Content-Type-Options: nosniff

# ── Build-baked data ────────────────────────────────────────────────────
# Day-long edge cache, 1h browser cache. Re-baked GeoJSON propagates with
# the next deploy (Pages purges the edge); browsers revalidate hourly so
# returning visitors pick up changes without a hard refresh.
/*.geojson
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  CDN-Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# ── Feeds ───────────────────────────────────────────────────────────────
/feed.xml
  Cache-Control: public, max-age=900, stale-while-revalidate=3600
  CDN-Cache-Control: public, max-age=1800, stale-while-revalidate=86400

# ── HTML pages ──────────────────────────────────────────────────────────
# 0 browser TTL + long edge TTL with stale-while-revalidate. Pages purges
# the edge on deploy, so a 6h s-maxage is safe and dramatically lifts
# edge hit rate for repeat visitors that already have the asset shell
# cached. 103 Early Hints push the shell preloads while origin renders.
# Anton latin is the only self-hosted face (signage). Body text is system-ui.
/
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: public, s-maxage=21600, stale-while-revalidate=604800
  Link: </fonts/Anton-latin.woff2>; rel=preload; as=font; type=font/woff2; crossorigin

/*/
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: public, s-maxage=21600, stale-while-revalidate=604800
  Link: </fonts/Anton-latin.woff2>; rel=preload; as=font; type=font/woff2; crossorigin

/*.html
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: public, s-maxage=21600, stale-while-revalidate=604800
